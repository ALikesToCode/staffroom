rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The teacher's own record of each receipt, written by the teacher's browser. It holds counts, times,
    // where each step ran, the length of the approved text, and how many constraints the teacher confirmed
    // and how many needs were told to the cloud (counts, with no kind and no words): no text. A user can add and read their own;
    // nobody can edit or delete one. These rules fix the form of a record. They cannot tell whether what a
    // record says is true: whoever is signed in to the account can write one.
    // The id has the form the app generates: the time in base 36, a hyphen, six characters. It is the same
    // id as the receipt kept in the teacher's browser, which is how the two are paired.
    match /users/{uid}/receipts/{receiptId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && receiptId.matches('^[0-9a-z]{8,9}-[0-9a-z]{6}$')
        && validRecord(request.resource.data, receiptId);
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }

    function isCount(v) {
      return v is int && v >= 0 && v <= 1000000;
    }

    // An ISO-8601 time in UTC, as the app writes it: 2026-11-26T10:15:30.123Z
    function isTime(v) {
      return v is string && v.size() <= 40
        && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$');
    }

    function validWithheld(m) {
      return m is map
        && m.keys().hasOnly(['student', 'adult', 'place', 'contact', 'id', 'private'])
        && m.keys().hasAll(['student', 'adult', 'place', 'contact', 'id', 'private'])
        && isCount(m.student) && isCount(m.adult) && isCount(m.place)
        && isCount(m.contact) && isCount(m.id) && isCount(m.private);
    }

    function validVerdicts(m) {
      return m is map
        && m.keys().hasOnly(['fits', 'conflict', 'unsure', 'nothingWithheld', 'notChecked'])
        && m.keys().hasAll(['fits', 'conflict', 'unsure', 'nothingWithheld', 'notChecked'])
        && isCount(m.fits) && isCount(m.conflict) && isCount(m.unsure)
        && isCount(m.nothingWithheld) && isCount(m.notChecked);
    }

    function validFlags(m) {
      return m is map
        && m.keys().hasOnly(['replyFlagged', 'unreadParagraphs', 'droppedDetails'])
        && m.keys().hasAll(['replyFlagged', 'unreadParagraphs', 'droppedDetails'])
        && m.replyFlagged is bool && isCount(m.unreadParagraphs) && isCount(m.droppedDetails);
    }

    // The model that wrote the draft, from an exact list: the on-device model under the one name the app
    // gives it, the cloud models the app can name, or "other". Nothing else, so this field cannot carry text.
    function isModel(v) {
      return v in ['Gemini Nano (Chrome built-in)', 'other', 'gemini-3.5-flash-lite', 'gemini-3.5-flash',
        'gemini-3.5-pro', 'gemini-3-flash', 'gemini-3-flash-lite'];
    }

    // Exactly these keys, each with its type and a bound on its size. There is no free string:
    // the two times are ISO-8601 and the model name is from an exact list.
    function validRecord(d, receiptId) {
      return d.keys().hasOnly(['id', 'createdAt', 'task', 'withheld', 'released', 'approvedAt', 'approvedChars',
          'guardWhere', 'draftWhere', 'draftModel', 'checkWhere', 'labelWhere', 'verdicts',
          'kept', 'struck', 'flags', 'conflictsByRule', 'doubtsByModel', 'constraintsConfirmed', 'needsShared'])
        && d.keys().hasAll(['id', 'createdAt', 'task', 'withheld', 'released', 'approvedAt', 'approvedChars',
          'guardWhere', 'draftWhere', 'draftModel', 'checkWhere', 'labelWhere', 'verdicts',
          'kept', 'struck', 'flags', 'conflictsByRule', 'doubtsByModel', 'constraintsConfirmed', 'needsShared'])
        && d.id is string && d.id == receiptId
        && isTime(d.createdAt) && isTime(d.approvedAt)
        && d.task in ['lesson', 'plan', 'parents', 'handover']
        && validWithheld(d.withheld)
        && isCount(d.released)
        && isCount(d.approvedChars)
        && d.guardWhere in ['ON_DEVICE', 'RULES_ONLY']
        && d.draftWhere in ['ON_DEVICE', 'IN_CLOUD']
        && isModel(d.draftModel)
        && d.checkWhere in ['ON_DEVICE', 'RULES_ONLY', 'NOT_RUN', 'SKIPPED']
        && d.labelWhere in ['ON_DEVICE', 'IN_CLOUD', 'FALLBACK']
        && validVerdicts(d.verdicts)
        && isCount(d.kept) && isCount(d.struck)
        && validFlags(d.flags)
        && isCount(d.conflictsByRule) && isCount(d.doubtsByModel) && isCount(d.constraintsConfirmed)
        && isCount(d.needsShared);
    }
  }
}
